module event_bus.event_bus_interface;

import std.traits : Unqual;

alias SubscriptionToken = size_t;

// ─── isOverridableEvent ───────────────────────────────────────────────────

/**
 * Detects whether an event type opts in to tail-override behaviour
 * (meaningful for asynchronous buses only).
 *
 * To opt in, define a nested enum inside your event struct:
 *
 *   struct ProgressEvent {
 *       enum isOverridable = true;
 *       int value;
 *   }
 */
template isOverridableEvent(T)
{
    static if (__traits(hasMember, T, "isOverridable"))
        enum isOverridableEvent = T.isOverridable;
    else
        enum isOverridableEvent = false;
}

// ─── EventOps: type-erased description of an event type ──────────────────

/**
 * Everything a bus needs to handle an event whose static type is erased:
 * identity, size, override policy and type-correct copy/destroy.
 *
 * Generated by `eventOps!T` in the typed wrappers, where T is still known,
 * so copying honours postblits and copy constructors (TypeInfo alone does not).
 */
struct EventOps
{
    TypeInfo ti;
    size_t size;
    bool overridable;
    /// Copy-constructs the event from `src` into uninitialised storage `dst`.
    void function(scope const(void)* src, void[] dst) copy;
    /// Destroys the event stored in `obj` (storage itself is not freed).
    void function(void[] obj) dispose;
}

EventOps eventOps(T)()
{
    static void copyImpl(scope const(void)* src, void[] dst)
    {
        import core.lifetime : emplace;

        // const is cast away the same way a by-value copy of `const T` would
        // need to for types with mutable indirections.
        emplace(cast(T*) dst.ptr, *cast(T*) src);
    }

    static void disposeImpl(void[] obj)
    {
        destroy(*cast(T*) obj.ptr);
    }

    return EventOps(typeid(T), T.sizeof, isOverridableEvent!T, &copyImpl, &disposeImpl);
}

// ─── SignalConsumer interface ──────────────────────────────────────────────

interface SignalConsumer
{
    SubscriptionToken subscribeRaw(TypeInfo ti, void delegate(const(void)*) cb);
    bool unsubscribe(SubscriptionToken token);

    /**
     * Subscribe with a typed delegate: void delegate(const EventType).
     * The event type is inferred from the delegate signature.
     */
    final SubscriptionToken subscribe(EventType)(void delegate(const EventType) cb)
    {
        return subscribeRaw(typeid(Unqual!EventType), (const(void)* p) {
            cb(*cast(const EventType*) p);
        });
    }

    /// ditto — accepts a function pointer as well
    final SubscriptionToken subscribe(EventType)(void function(const EventType) cb)
    {
        return subscribe!EventType((const EventType e) { cb(e); });
    }
}

// ─── SignalProducer interface ──────────────────────────────────────────────

interface SignalProducer
{
    /**
     * Publish a type-erased event. `data` is only valid for the duration of
     * the call: an implementation that defers delivery must copy it via `ops`.
     */
    void publishRaw(EventOps ops, scope const(void)* data);

    final void publish(EventType)(auto ref const EventType event)
    {
        publishRaw(eventOps!(Unqual!EventType), &event);
    }
}
