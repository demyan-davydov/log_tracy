# Text files with \n on every system, Windows too: the tests read the sources (backend-calls)
* text=auto eol=lf

# The Sciter libraries of libs/ are kept in Git LFS packed by brotli (<library>.br): the
# repository holds a pointer, LFS the archive; scripts/build.mjs unpacks it next to itself
libs/**/*.br filter=lfs diff=lfs merge=lfs -text
