name "log_tracy"
description "DLT file viewer"
authors "Demian Davidov"
copyright "Copyright © 2026, Demian Davidov"
license "proprietary"
dependency "dxml" version="~>0.4.5"
stringImportPaths "resources" // the files of the interface, built in by ui/app_resources

// Every build in its own folder (osx-aarch64-debug, linux-x86_64-unittest, ...) with the Sciter
// library next to the program, `dub test` too. scripts/build.mjs builds through dub, after it
// unpacks the library of the build from its archive in Git LFS (<library>.br)
targetPath "build/$PLATFORM-$ARCH-$BUILD_TYPE"
copyFiles "libs/macosx/libsciter.dylib" platform="osx" // universal: x86_64 and arm64
copyFiles "libs/linux/x64/libsciter.so" platform="linux-x86_64"
copyFiles "libs/linux/arm64/libsciter.so" platform="linux-aarch64"
copyFiles "libs/windows/x64/sciter.dll" platform="windows-x86_64"
copyFiles "libs/windows/arm64/sciter.dll" platform="windows-aarch64"
lflags "-framework" "Cocoa" "-L/usr/lib" platform="osx"

dflags "-preview=in" // in -> const scope
dflags "-preview=dip1000" // strict control for scope and references lifetimes
dflags "-preview=dtorfields" // correct fields destruction

// Release (build --release, run --release, dist): dub's own release (-O3 -release, inlining)
// without bounds checks, which -release keeps in @safe code
buildType "release" {
	buildOptions "releaseMode" "optimize" "inline" "noBoundsCheck"
}

// Distribution (dist): the release of a program installed into the system, which keeps its
// settings in the user's folder instead of next to itself (ui/app_settings, settingsDir)
buildType "dist" {
	buildOptions "releaseMode" "optimize" "inline" "noBoundsCheck"
	versions "Installed"
}

// The icon of the program on Windows: ldc2 links a .res, not a .rc, so app.rc is compiled
// into build/windows/app.res before every build (scripts/windows-res.mjs, rc.exe)
preBuildCommands "node \"$PACKAGE_DIR/scripts/windows-res.mjs\"" platform="windows"
sourceFiles "build/windows/app.res" platform="windows"

// The program (dub build, the first configuration) and the library dub test builds its runner
// of the unittests from. Only the program is a window application of Windows: the runner
// keeps the console its output goes to
configuration "application" {
	targetType "executable"
	// ldc2 makes wmain of D's main on Windows: a window application starts there, not at
	// WinMain (the default of /SUBSYSTEM:WINDOWS) nor main (mainCRTStartup)
	lflags "/SUBSYSTEM:WINDOWS" "/ENTRY:wmainCRTStartup" platform="windows"
}
configuration "library" {
	targetType "library"
	excludedSourceFiles "source/app.d" // the program's main: dub test brings its own
}

