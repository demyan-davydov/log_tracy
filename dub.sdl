name "log_tracy"
description "DLT file viewer"
authors "Demian Davidov"
copyright "Copyright © 2026, Demian Davidov"
license "proprietary"
dependency "dxml" version="~>0.4.5"
stringImportPaths "resources" // the files of the interface, built in by ui/app_resources

// Every build in its own folder (osx-aarch64-debug, linux-x86_64-unittest, ...) with the Sciter
// library next to the program, `dub test` too. scripts/build.mjs builds through dub, after it
// unpacks the library of the build from its archive in Git LFS (<library>.br)
targetPath "build/$PLATFORM-$ARCH-$BUILD_TYPE"
// The library is put in place before dub copies it: scripts/utils/prepare-sciter.mjs fetches its
// archive from Git LFS and unpacks it. preGenerateCommands runs before dub decides whether to
// rebuild, so a plain `dub build`, `dub run` and `dub test` get it on a fresh clone too
preGenerateCommands "node \"$PACKAGE_DIR/scripts/utils/prepare-sciter.mjs\""
copyFiles "libs/macosx/libsciter.dylib" platform="osx" // universal: x86_64 and arm64
copyFiles "libs/linux/x64/libsciter.so" platform="linux-x86_64"
copyFiles "libs/linux/arm64/libsciter.so" platform="linux-aarch64"
copyFiles "libs/windows/x64/sciter.dll" platform="windows-x86_64"
copyFiles "libs/windows/arm64/sciter.dll" platform="windows-aarch64"
lflags "-framework" "Cocoa" "-L/usr/lib" platform="osx"

dflags "-preview=in" // in -> const scope
dflags "-preview=dip1000" // strict control for scope and references lifetimes
dflags "-preview=dtorfields" // correct fields destruction

// Release (build --release, run --release, dist): dub's own release (-O3 -release, inlining)
// without bounds checks, which -release keeps in @safe code
buildType "release" {
	buildOptions "releaseMode" "optimize" "inline" "noBoundsCheck"
}

// Distribution (dist): the release of a program installed into the system, which keeps its
// settings in the user's folder instead of next to itself (ui/app_settings, settingsDir)
buildType "dist" {
	buildOptions "releaseMode" "optimize" "inline" "noBoundsCheck"
	versions "Installed"
}

// The program (dub build, the first configuration) and the runner of the unittests (dub test
// takes the configuration named unittest). Only the program is a window application of
// Windows: the runner keeps the console its output goes to
configuration "application" {
	targetType "executable"
	// The icon of the program on Windows: ldc2 links a .res, not a .rc, so app.rc is compiled
	// into build/windows/app.res before every build (scripts/windows-res.mjs, rc.exe). Not in
	// the runner of the unittests: gen_ut_main takes every file dub lists for a module of D
	preBuildCommands "node \"$PACKAGE_DIR/scripts/windows-res.mjs\"" platform="windows"
	sourceFiles "build/windows/app.res" platform="windows"
	// ldc2 makes wmain of D's main on Windows: a window application starts there, not at
	// WinMain (the default of /SUBSYSTEM:WINDOWS) nor main (mainCRTStartup)
	lflags "/SUBSYSTEM:WINDOWS" "/ENTRY:wmainCRTStartup" platform="windows"
}
// unit-threaded's runner: every unittest block a test of its own (the ones after a failed one
// still run), a filter by name (dub test -- <name>...), its options by -- -h. Its main is
// generated before every build from the modules of the package (gen_ut_main). One thread
// (unitUnthreaded): tests that share a global state are safe, and they run fast anyway. dub
// runs the command in the package's folder and puts in $DUB and $DC itself (no shell's
// variables: cmd.exe has none of that form); the generator is of the version the runner is
configuration "unittest" {
	targetType "executable"
	dependency "unit-threaded" version="~>2.2.6"
	versions "unitUnthreaded" "DebugChannel"
	mainSourceFile "build/unittest/ut.d"
	excludedSourceFiles "source/app.d" // the program's main
	preBuildCommands "\"$DUB\" run --compiler=\"$DC\" unit-threaded@2.2.6 -c gen_ut_main -- -f build/unittest/ut.d -d \"$DUB\""
	// After the unittests: the JS tests of tests/js and the names of .ai/ the code no longer has,
	// so a plain `dub test` runs everything `node scripts/test.mjs` does. --hook: they keep out
	// when scripts/build.mjs test runs them itself (NO_DUB_HOOKS)
	postRunCommands "node \"$PACKAGE_DIR/scripts/utils/test-js.mjs\" --hook"
	postRunCommands "node \"$PACKAGE_DIR/scripts/utils/check-ai-context.mjs\" --hook"
}

